     fea:	b0 e0       	ldi	r27, 0x00	; 0
     fec:	e9 e5       	ldi	r30, 0x59	; 89
     fee:	f0 e0       	ldi	r31, 0x00	; 0
     ff0:	80 81       	ld	r24, Z
     ff2:	80 61       	ori	r24, 0x10	; 16
     ff4:	8c 93       	st	X, r24

	}
     ff6:	cf 91       	pop	r28
     ff8:	df 91       	pop	r29
     ffa:	08 95       	ret

