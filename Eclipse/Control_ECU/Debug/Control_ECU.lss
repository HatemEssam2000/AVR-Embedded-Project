    13b8:	de b7       	in	r29, 0x3e	; 62
    13ba:	89 83       	std	Y+1, r24	; 0x01

	TCNT0 = 0; // Set Timer Initial Value to 0
    13bc:	e2 e5       	ldi	r30, 0x52	; 82
    13be:	f0 e0       	ldi	r31, 0x00	; 0
    13c0:	10 82       	st	Z, r1

	OCR0  = (uint8)(duty_cycle); //Set Compare value
    13c2:	ec e5       	ldi	r30, 0x5C	; 92
    13c4:	f0 e0       	ldi	r31, 0x00	; 0
    13c6:	89 81       	ldd	r24, Y+1	; 0x01
    13c8:	80 83       	st	Z, r24

	DDRB  = DDRB | (1<<PB3); // Configure PB3/OC0 as output pin --> pin where the PWM signal is generated from MC
    13ca:	a7 e3       	ldi	r26, 0x37	; 55
    13cc:	b0 e0       	ldi	r27, 0x00	; 0
    13ce:	e7 e3       	ldi	r30, 0x37	; 55
    13d0:	f0 e0       	ldi	r31, 0x00	; 0
    13d2:	80 81       	ld	r24, Z
    13d4:	88 60       	ori	r24, 0x08	; 8
    13d6:	8c 93       	st	X, r24
	 * 1. Fast PWM mode FOC0=0
	 * 2. Fast PWM Mode WGM01=1 & WGM00=1
	 * 3. Clear OC0 when match occurs (non inverted mode) COM00=0 & COM01=1
	 * 4. clock = F_CPU/8 CS00=0 CS01=1 CS02=0
	 */
	TCCR0 = (1<<WGM00) | (1<<WGM01) | (1<<COM01) | (1<<CS01);
    13d8:	e3 e5       	ldi	r30, 0x53	; 83
    13da:	f0 e0       	ldi	r31, 0x00	; 0
    13dc:	8a e6       	ldi	r24, 0x6A	; 106
    13de:	80 83       	st	Z, r24

}
